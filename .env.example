CAPSULE_MODE=simulation
CAPSULE_HOST=127.0.0.1
CAPSULE_PORT=8080
CAPSULE_ALLOW_LAN=false
CAPSULE_TOKEN=
CAPSULE_STATE_DIR=./state
GOOGLE_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-live
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTING=auto
GEMINI_COOLDOWN_SECONDS=120
ASSISTANT_MAX_VOLUME=75
VOSK_MODEL_PATH=
PIPER_MODEL_PATH=
# Optional: v3rt3p/marusya-server, own configured device only
MARUSYA_SERVER_URL=
MARUSYA_DEVICE_ID=
# Optional: yawaflua/Gemini-for-Capsula, authenticated panel
GEMINI_CAPSULA_URL=
GEMINI_CAPSULA_DEVICE_ID=
GEMINI_CAPSULA_PANEL_PASSWORD=

# Optional assistant feature; no dedicated player in the web menu
RADIO_MAX_VOLUME=75
RADIO_RESUME_AFTER_REBOOT=false
RADIO_DIRECTORY_URL=https://de1.api.radio-browser.info
RADIO_DEFAULT_STATION=Радио Дача

# Existing SSH access; this does not unlock the speaker
CAPSULE_SSH_HOST=
CAPSULE_SSH_USER=root
CAPSULE_SSH_PORT=22
CAPSULE_SSH_IDENTITY_FILE=
CAPSULE_SSH_KNOWN_HOSTS_FILE=
